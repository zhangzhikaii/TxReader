# TxReader 的设置。复制成 .env 再修改：cp .env.example .env
# .env 里有密码哈希，已被 git 忽略，不要提交。已在系统环境变量里设置的项优先。

# 登录密码的哈希（只需生成一次）：运行 .venv/bin/python -m txreader.auth，把输出整行填在等号后面
TXREADER_PASSWORD_HASH=

# 设为 off 则不需要登录（只适合在自己电脑上用，服务器上不要这样设）
# TXREADER_AUTH=off

# 多少分钟没有操作就自动退出登录，默认 120
# TXREADER_IDLE_MINUTES=120

# 数据目录（数据库和截图），默认是项目下的 data/
# TXREADER_DATA=data
